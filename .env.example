PMQ_DOMAIN=apps.example.com
# Generate a long random secret and keep .env private.
PMQ_DEPLOY_TOKEN=replace-with-a-long-random-secret
# Replace with the proxy's actual source IP as seen inside the container.
PMQ_TRUSTED_PROXIES=172.17.0.1/32
PMQ_IDENTITY_HEADER=X-PMQ-User

# Storage defaults to filesystem in the PMQ data directory.
PMQ_STORAGE_PROVIDER=filesystem
# For an existing S3-compatible bucket, set PMQ_STORAGE_PROVIDER=s3 and:
# PMQ_S3_ENDPOINT=s3.example.com:443  # host[:port], no URL scheme
# PMQ_S3_REGION=us-east-1
# PMQ_S3_BUCKET=pmq
# PMQ_S3_ACCESS_KEY=replace-me
# PMQ_S3_SECRET_KEY=replace-me
# PMQ_S3_SESSION_TOKEN=optional-temporary-session-token
# PMQ_S3_INSECURE=false              # true disables TLS; use only on trusted networks
# PMQ_S3_PATH_STYLE=true             # use path-style bucket addressing
